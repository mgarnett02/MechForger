{
  "name": "mechforger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "convert-canon": "vite-node tools/convert-megamek.ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "description": "BattleTech BattleMech construction tool",
  "author": "mgarnett02",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mgarnett02.mechforger",
    "productName": "MechForger",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "MechForger-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MechForger-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MechForger-Portable-${version}.${ext}",
      "unpackDirName": "MechForger"
    }
  }
}
